NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GCash receipts. Shown on the plan card. The number is a PH mobile (09xxxxxxxxx).
GCASH_NUMBER=
GCASH_ACCOUNT_NAME=

# PayMongo stays in the codebase and is hidden while hosts pay by GCash receipt.
# Club plan is ₱799 for one month. Tournament days are ₱2,000 each.
# The webhook endpoint is {SITE_URL}/api/paymongo/webhook
# Subscribe that endpoint to checkout_session.payment.paid.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Service role writes billing rows from the webhook and reads the operator panel.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# First operator account: open /admin/login while no operator exists.
# Localhost can create that account directly. Production needs a setup key of
# at least 8 characters. Later operator accounts are created inside the panel.
# An operator login cannot open the host dashboard.
PLATFORM_ADMIN_SETUP_KEY=

# Enable Google under Supabase Auth → Providers, then add {SITE_URL}/auth/callback
# to Google Cloud OAuth redirect URIs and Supabase Auth URL configuration.
