NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayMongo. Club plan is ₱699 for one month. Tournament days are ₱1,500, or ₱4,000 for four consecutive days.
# The webhook endpoint is {SITE_URL}/api/paymongo/webhook
# Subscribe that endpoint to checkout_session.payment.paid.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Service role writes billing rows from the webhook. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Enable Google under Supabase Auth → Providers, then add {SITE_URL}/auth/callback
# to Google Cloud OAuth redirect URIs and Supabase Auth URL configuration.
